# LLM Provider: 'openai' or 'gemini'
LLM_PROVIDER=openai

# OpenAI configuration (for LLM chat)
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://codexpool.zeabur.app/v1  # optional, for custom endpoints
LLM_MODEL=gpt-5.3-codex

# Gemini configuration (if LLM_PROVIDER=gemini)
# GEMINI_API_KEY=your-gemini-key-here
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash

# SiliconFlow embedding configuration (独立于 LLM 提供商，优先级最高)
# 申请地址：https://cloud.siliconflow.cn/account/ak
# 可用模型：BAAI/bge-m3 (多语言, 8192 tokens) | BAAI/bge-large-zh-v1.5 (中文) | BAAI/bge-large-en-v1.5 (英文)
SILICONFLOW_API_KEY=sk-your-siliconflow-key-here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

# Fallback embedding model (当 SILICONFLOW_API_KEY 未设置时使用)
EMBEDDING_MODEL=text-embedding-3-small
